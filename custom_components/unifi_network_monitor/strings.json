  "services": {
    "cleanup_unused_entities": {
      "name": "Clean up unused entities",
      "description": "Removes entities the current options no longer provide — per-UniFi-device sensors excluded by the device mode, and gateway sensors for any feature toggled off — and detaches any device left with no Monitor entities.",
      "fields": {
        "dry_run": {
          "name": "Dry run",
          "description": "When on (default), only reports what would be removed without changing anything."
        }
      }
    },
    "get_alerts": {
      "name": "Get alerts",
      "description": "Returns a capped, human-readable slice of the UniFi system log on demand. Results are limited to the newest ~500 records; LOW/MEDIUM can be very high-volume.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The UniFi Network Monitor gateway to query. Optional when only one is configured."
        },
        "severity": {
          "name": "Severity",
          "description": "Which severity levels to include. Defaults to High and Very High."
        },
        "quantity": {
          "name": "Quantity",
          "description": "Maximum number of alerts to return (1–100, default 10)."
        },
        "age_days": {
          "name": "Age (days)",
          "description": "Only return alerts newer than this many days."
        },
        "keyword": {
          "name": "Keyword",
          "description": "Case-insensitive substring to match against the alert title and message."
        }
      }
    },
    "get_rogue_aps": {
      "name": "Get Rogue APs",
      "description": "Returns the current rogue-AP set on demand. Fetches fresh data, so it works even when Security monitoring is off, and does not apply the Security ignore lists.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The UniFi Network Monitor gateway to query. Optional when only one is configured."
        },
        "period": {
          "name": "Period",
          "description": "How far back to look for rogue APs. 'All available' spans the controller's full retention. Defaults to Last 24 hours."
        },
        "band": {
          "name": "Band",
          "description": "Which Wi-Fi band(s) to include. Defaults to both."
        },
        "min_signal": {
          "name": "Minimum signal",
          "description": "Only return rogue APs at or above this signal strength in dBm (e.g. -70). Leave blank for all."
        },
        "quantity": {
          "name": "Quantity",
          "description": "Maximum number of rogue APs to return, strongest first (1–100, default 10)."
        },
        "keyword": {
          "name": "Keyword",
          "description": "Case-insensitive substring to match against the SSID and OUI (vendor)."
        }
      }
    }
  }
