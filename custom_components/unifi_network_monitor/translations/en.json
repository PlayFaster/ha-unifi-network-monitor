{
  "config": {
    "step": {
      "user": {
        "title": "Set up UniFi Network Monitor",
        "description": "Connect to your UDM Pro. API key strongly recommended — username/password works but leaves firewall, VPN, and WAN-name unavailable.",
        "data": {
          "host": "Host / IP Address",
          "api_key": "API Key (preferred)",
          "username": "Username",
          "password": "Password",
          "site": "Site ID",
          "unifi_device_mode": "UniFi device (Access Point & Switch) sensors"
        },
        "data_description": {
          "host": "IP address or hostname of the UDM Pro (e.g. 192.168.1.1)",
          "api_key": "Local API key from UniFi Network Settings → Control Plane → API Keys",
          "username": "Username only required if not using an API key",
          "password": "Password only required if not using an API key",
          "site": "UniFi site ID — leave as 'default' unless you have multiple sites",
          "unifi_device_mode": "How much per-device detail to add for your APs and switches. Leave off if the native UniFi integration already covers them."
        },
        "sections": {
          "sensor_groups": {
            "name": "Sensor groups — enable or disable",
            "data": {
              "enable_speedtest": "Speedtest monitoring"
            },
            "data_description": {
              "enable_speedtest": "WAN speedtest sensors and manual run buttons."
            }
          }
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate UniFi Network Monitor",
        "description": "Credentials for {host} were rejected. Update your API key or password. API key strongly recommended — username/password works but leaves firewall, VPN, and WAN-name unavailable.",
        "data": {
          "host": "Host / IP Address",
          "api_key": "API Key (preferred)",
          "username": "Username",
          "password": "Password",
          "site": "Site ID"
        }
      },
      "reconfigure": {
        "title": "Reconfigure UniFi Network Monitor",
        "description": "Update settings for {host}. API key strongly recommended — username/password works but leaves firewall, VPN, and WAN-name unavailable. Unchecking a sensor group hides its sensors and reduces polling. Existing entities are not deleted automatically — use the ‘Clean Up Unused Entities’ button or the unifi_network_monitor.cleanup_unused_entities action to remove them.",
        "data": {
          "host": "Host / IP Address",
          "api_key": "API Key (preferred)",
          "username": "Username",
          "password": "Password",
          "site": "Site ID",
          "unifi_device_mode": "UniFi device (Access Point & Switch) sensors"
        },
        "data_description": {
          "api_key": "Leave blank to keep the current API key, or enter a new one to change it.",
          "password": "Leave blank to keep the current password, or enter a new one to change it.",
          "unifi_device_mode": "How much per-device detail to add for your APs and switches."
        },
        "sections": {
          "sensor_groups": {
            "name": "Sensor groups — enable or disable",
            "data": {
              "enable_speedtest": "Speedtest monitoring",
              "enable_wan_usage": "WAN data-usage statistics",
              "enable_security_monitoring": "Security monitoring"
            },
            "data_description": {
              "enable_speedtest": "WAN speedtest sensors and manual run buttons.",
              "enable_wan_usage": "Daily and monthly WAN data-usage sensors.",
              "enable_security_monitoring": "Rogue-AP, VPN and firewall sensors."
            }
          }
        }
      }
    },
    "error": {
